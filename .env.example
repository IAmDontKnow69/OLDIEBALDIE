# Environment variables (copy to .env and fill values)

# Discord bot token (BOT user)
DISCORD_TOKEN=
# FACEIT API key
FACEIT_API_KEY=
# Primary Guild ID where the bot runs
GUILD_ID=
# Optional: team logo URL for embeds
TEAM_LOGO_URL=
# Optional: category ID under which matchday voice channels will be created
CATEGORY_MATCHDAY_ID=
